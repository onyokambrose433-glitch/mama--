# Mama Shopping Center Backend Environment Configuration

# Django Settings
SECRET_KEY=your-production-secret-key-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=mama-backend.onrender.com,localhost,127.0.0.1

# PostgreSQL Database (Render, Supabase, Neon, or local Postgres)
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Super Administrator Credentials (used during initial deployment)
ADMIN_EMAIL=admin@mamashoppingcenter.com
ADMIN_PASSWORD=SetAStrongPassword2026!

# Uganda Mobile Money & Payment Gateway Keys (Flutterwave / MTN MoMo Open API)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxx
FLUTTERWAVE_SECRET_HASH=your_webhook_secret_hash
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_PRIMARY_KEY=

# Cloudinary Image Storage (Optional: if using Cloudinary for images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Store Info
STORE_CURRENCY=UGX
TIME_ZONE=Africa/Kampala
